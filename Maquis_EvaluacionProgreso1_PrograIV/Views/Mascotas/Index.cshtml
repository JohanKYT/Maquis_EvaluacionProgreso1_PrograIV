@model IEnumerable<Maquis_EvaluacionProgreso1_PrograIV.Models.Mascota>

@{
	ViewData["Title"] = "Index";
}

<h1>Mascotas</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">
		<i class="bi bi-plus-circle"></i> Ingresar nueva mascota
	</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Nombre)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Raza)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Peso)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaNacimiento)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.PropietarioMascota)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Nombre)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Raza)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Peso)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.FechaNacimiento)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.PropietarioMascota.Correo)
				</td>
				<td>
					<a asp-action="Edit" class="btn btn-outline-warning" asp-route-id="@item.Id">
						<i class="bi bi-pencil-square"></i> Edit
					</a> |
					<a asp-action="Details" class="btn btn-outline-info" asp-route-id="@item.Id">
						<i class="bi bi-eye"></i> Details
					</a> |
					<a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id">
						<i class="bi bi-trash"></i> Delete
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>
