@model IEnumerable<Maquis_EvaluacionProgreso1_PrograIV.Models.VisitaVeterinaria>

@{
	ViewData["Title"] = "Index";
}

<h1>Citas</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">
		<i class="bi bi-plus-circle"></i> Ingresar nueva cita
	</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.FechaVisita)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.MotivoVisita)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.RequiereMedicacion)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.CostoMedicacion)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Mascota)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.CostoTotal)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.FechaVisita)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.MotivoVisita)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.RequiereMedicacion)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.CostoMedicacion)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Mascota.Nombre)
				</td>
				<td>
					@item.CostoTotal.ToString("C")
				</td>
				<td>
					<a asp-action="Edit" class="btn btn-outline-warning" asp-route-id="@item.Id">
						<i class="bi bi-pencil-square"></i> Edit
					</a> |
					<a asp-action="Details" class="btn btn-outline-info" asp-route-id="@item.Id">
						<i class="bi bi-eye"></i> Details
					</a> |
					<a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id">
						<i class="bi bi-trash"></i> Delete
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>
