@model Maquis_EvaluacionProgreso1_PrograIV.Models.VisitaVeterinaria

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>VisitaVeterinaria</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FechaVisita" class="control-label"></label>
                <input asp-for="FechaVisita" class="form-control" />
                <span asp-validation-for="FechaVisita" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MotivoVisita" class="control-label"></label>
                <select asp-for="MotivoVisita" class="form-control"></select>
                <span asp-validation-for="MotivoVisita" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RequiereMedicacion" /> @Html.DisplayNameFor(model => model.RequiereMedicacion)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="CostoMedicacion" class="control-label"></label>
                <input asp-for="CostoMedicacion" class="form-control" />
                <span asp-validation-for="CostoMedicacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MascotaId" class="control-label"></label>
                <select asp-for="MascotaId" class ="form-control" asp-items="ViewBag.MascotaId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-success" />
                <a class="btn btn-primary" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
